# =============================================================================
# Binance WebSocket Configuration
# =============================================================================

BINANCE_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_STREAMS=btcusdt@trade,ethusdt@trade,bnbusdt@trade,xrpusdt@trade,solusdt@trade,adausdt@trade,dogeusdt@trade,trxusdt@trade,avaxusdt@trade,linkusdt@trade,dotusdt@trade,maticusdt@trade,shibusdt@trade,ltcusdt@trade,atomusdt@trade,uniusdt@trade,xlmusdt@trade,nearusdt@trade,aptusdt@trade,icpusdt@trade,filusdt@trade,etcusdt@trade,arbusdt@trade,opusdt@trade,suiusdt@trade,btcusdt@ticker,ethusdt@ticker,bnbusdt@ticker,xrpusdt@ticker,solusdt@ticker,adausdt@ticker,dogeusdt@ticker,trxusdt@ticker,avaxusdt@ticker,linkusdt@ticker,dotusdt@ticker,maticusdt@ticker,shibusdt@ticker,ltcusdt@ticker,atomusdt@ticker,uniusdt@ticker,xlmusdt@ticker,nearusdt@ticker,aptusdt@ticker,icpusdt@ticker,filusdt@ticker,etcusdt@ticker,arbusdt@ticker,opusdt@ticker,suiusdt@ticker
RECONNECT_MAX_DELAY_SECONDS=60
WS_CONNECTION_TIMEOUT=10

# =============================================================================
# Kafka Configuration
# =============================================================================

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_MAX_RATE_PER_PARTITION=50000
KAFKA_ACKS=all

# Kafka Topics
TOPIC_RAW_TRADES=raw_trades
TOPIC_RAW_TICKERS=raw_tickers
TOPIC_PROCESSED_AGGREGATIONS=processed_aggregations
TOPIC_ALERTS=alerts

# =============================================================================
# Spark Streaming Configuration
# =============================================================================

SPARK_EXECUTOR_CORES=1
SPARK_SHUFFLE_PARTITIONS=2
SPARK_CHECKPOINT_LOCATION=/opt/airflow/data/spark-checkpoints
SPARK_BACKPRESSURE_ENABLED=true

# =============================================================================
# Redis Configuration (Hot Path)
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# PostgreSQL - Airflow Metadata Database
# =============================================================================

AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
AIRFLOW_POSTGRES_DB=airflow
AIRFLOW_POSTGRES_PORT=5433

# =============================================================================
# PostgreSQL - Data Storage (Permanent Storage)
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto
POSTGRES_DB=crypto_data

# =============================================================================
# Ticker/Symbols Configuration
# =============================================================================

TICKER_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,XRPUSDT,SOLUSDT,ADAUSDT,DOGEUSDT,TRXUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,MATICUSDT,SHIBUSDT,LTCUSDT,ATOMUSDT,UNIUSDT,XLMUSDT,NEARUSDT,APTUSDT,ICPUSDT,FILUSDT,ETCUSDT,ARBUSDT,OPUSDT,SUIUSDT
TICKER_TTL_SECONDS=60

# =============================================================================
# Grafana Configuration
# =============================================================================

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# =============================================================================
# Airflow Configuration
# =============================================================================

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__CORE__FERNET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=

