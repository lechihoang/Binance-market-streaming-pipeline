FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libpq-dev libsnappy-dev librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.airflow.txt ./requirements.txt

RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

FROM python:3.11-slim AS runtime

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libpq5 libsnappy1v5 librdkafka1 procps \
    openjdk-21-jre-headless \
    libgomp1 \
    tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-arm64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

ENV _JAVA_OPTIONS="--add-opens=java.base/java.nio=ALL-UNNAMED \
    --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
    --add-opens=java.base/java.lang=ALL-UNNAMED"

COPY --from=builder /install /usr/local

COPY ingestion/ ./ingestion/
COPY storage/ ./storage/
COPY processing/ ./processing/
COPY util/ ./util/
COPY ml/ ./ml/
COPY schema/ ./schema/

ENV AIRFLOW_HOME=/opt/airflow
ENV PYTHONPATH=/app:/opt/airflow
ENV SPARK_HOME=/usr/local/lib/python3.11/site-packages/pyspark
ENV PATH="${SPARK_HOME}/bin:${PATH}"
ENV PYSPARK_PYTHON=/usr/local/bin/python3.11
ENV PYSPARK_DRIVER_PYTHON=/usr/local/bin/python3.11

RUN mkdir -p /app/data /opt/airflow/dags /opt/airflow/logs /opt/airflow/data/spark-checkpoints \
    && useradd -m -u 1000 airflow \
    && chown -R airflow:airflow /app /opt/airflow

USER airflow

CMD ["airflow", "version"]
